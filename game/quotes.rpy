# -*- coding: utf-8 -*-
# task #7: плавающие цитаты романа в главном меню.
# ONLY new file: screens.rpy / gui.rpy не тронуты, регистрация через config.overlay_screens.
#
# Механика:
#   - экран-оверлей (config.overlay_screens) рисуется поверх любого экрана,
#     но сам себя показывает только в главном меню (guard main_menu);
#   - zorder 5 задан keyword-свойством экрана (quick_menu=100 остаётся сверху);
#   - раз в mq_period (6-9 с, renpy.random.uniform) появляется новая цитата
#     из «мешка» без повторов; когда мешок пуст - перетасовка (reshuffle);
#   - позиция случайная в верхней/средней зоне (y 110..540 px из 1080),
#     кроме левой колонки навигации (x < 700 при y >= 300) и правого нижнего
#     угла (заголовок игры) - туда попадать нельзя, y <= 540 его не касается;
#   - появление: alpha 0->1 за 1.2 с, дрейф вверх на 40 px за время жизни,
#     затем fade out 1 с; общая длительность = mq_period.
#
# Цитаты: 20 коротких фраз из романа «Отцы и дети», все сверены с текстом
# (ilibrary/vikiteki-раскладка, grep по главам 5, 9, 10, 13, 17, 21, 25, 28).
# Атрибуции на экране нет - по заказу «просто текст, интересные фразы».
# Пример лида «Счастливые часов не наблюдают» в романе НЕ найден - не брал.

init python:
    config.overlay_screens.append("menu_quotes")

init python:
    QUOTES_MENU = [
        # Базаров
        u"Природа не храм, а мастерская, и человек в ней работник.",
        u"Рафаэль гроша медного не стоит.",
        u"Он человек отставной, его песенка спета.",
        u"Об одном прошу тебя: не говори красиво.",
        u"Я гляжу в небо только тогда, когда хочу чихнуть.",
        u"В теперешнее время полезнее всего отрицание — мы отрицаем.",
        u"Я ничьих мнений не разделяю: я имею свои.",
        u"Принципов вообще нет — ты об этом не догадался до сих пор!",
        u"Я чувствую только скуку да злость.",
        u"Любовь... ведь это чувство напускное.",
        u"Охота же быть романтиком в нынешнее время!",
        # Аркадий (в т.ч. определение нигилиста его словами, гл. 5)
        u"Мы ломаем, потому что мы сила.",
        u"Нигилист — это человек, который не склоняется ни перед какими авторитетами.",
        # Павел Петрович
        u"Нигилизм всему горю помочь должен.",
        u"Будьте счастливы, друзья мои!",
        # Николай Петрович
        u"Вот в том-то и беда, что мы не умеем говорить спичи!",
        # Анна Сергеевна (гл. 17)
        u"По-моему, или все, или ничего. Жизнь за жизнь.",
        # Катя (гл. 25)
        u"Он хищный, а мы с вами ручные.",
        # Арина Власьевна (гл. 21) и Фенечка (гл. 28)
        u"Что делать, Вася! Сын — отрезанный ломоть.",
        u"Вы меня извините, я не виновата.",
    ]

    # store-состояние экрана (функции пишут в глобалы стора)
    mq_bag = []          # «мешок» индексов: без повторов до исчерпания
    mq_disp = u""        # отображаемая строка (с «ёлочками»)
    mq_x = 40
    mq_y = 110
    mq_period = 7.5      # длительность жизни = интервал появления, 6..9 с
    mq_ready = False     # появилась ли уже первая цитата

    def mq_advance():
        """Выбрать следующую цитату, случайную позицию и новый интервал."""
        global mq_bag, mq_disp, mq_x, mq_y, mq_period, mq_ready
        if not mq_bag:
            mq_bag = list(range(len(QUOTES_MENU)))
            renpy.random.shuffle(mq_bag)
        index = mq_bag.pop()
        mq_disp = u"«" + QUOTES_MENU[index] + u"»"
        # Ловим позицию rejection sampling'ом: запрещены левая колонка
        # навигации (x < 700 при y >= 300) и нижняя половина ниже 540 px
        # (там заголовок игры в правом нижнем углу и нижняя кромка).
        # X начинается с 540: левая колонка затемнения (gui/overlay/
        # main_menu.png) кончается на 520, а блок цитаты шириной 620 px не
        # должен вылезать за внутреннюю рамку листа (x=1833).
        while True:
            x = int(renpy.random.uniform(540.0, 1180.0))
            y = int(renpy.random.uniform(110.0, 540.0))
            if x < 700 and y >= 300:
                continue
            break
        mq_x, mq_y = x, y
        mq_period = renpy.random.uniform(6.0, 9.0)
        mq_ready = True


transform mq_motion:
    # life cycle = mq_period: 1.2 с fade in, пауза до конца минус 1 с,
    # 1 с fade out; за это же время медленный дрейф вверх на 40 px.
    alpha 0.0
    yoffset 0
    parallel:
        linear 1.2 alpha 1.0
        pause (mq_period - 2.2)
        linear 1.0 alpha 0.0
    parallel:
        linear mq_period yoffset -40
    pause 0.1
    repeat


screen menu_quotes():
    # keyword-свойство экрана: авто-show оверлея берёт zorder отсюда
    # (renpy/display/screen.py: d.zorder = py_eval(screen.zorder)).
    zorder 5

    if main_menu and not renpy.variant("small"):
        if not mq_ready:
            # первая цитата почти сразу после открытия меню
            timer 0.3 action [Function(mq_advance), renpy.restart_interaction]
        else:
            text mq_disp at mq_motion:
                pos (mq_x, mq_y)
                xmaximum 620
                size 37
                color "#3a2c1c"
                italic True
                # мягкая светлая тень - читаемо и на parchment, и на дереве
                drop_shadow (2, 3)
                drop_shadow_color "#f5ecd0"
            # смена цитаты: через весь цикл жизни; перезапуск экрана
            # пересоздаёт timer уже с новым mq_period
            timer mq_period action [Function(mq_advance), renpy.restart_interaction]
